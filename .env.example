# P1 Meter Settings
P1_URL=http://192.168.0.11/api/v1/data
P1_BASE_URL=http://192.168.0.11

# Sun2000 Solar Inverter Settings (NEW)
# Set SUN2000_IP to your inverter's local network IP address
# Find device ID at: http://<SUN2000_IP>:8080/rest/data/v1/GetEquipmentInfo
SUN2000_IP=192.168.0.12
SUN2000_PORT=8080
SUN2000_DEVICE_ID=your_device_id_here

# Server Settings
HOST_PORT=8100
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APPLICATION_ROOT=
FLASK_DEBUG=false

# Data Storage (optional)
# P1_DATA_DIR=/path/to/data

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
ADMIN_TOKEN=
GAS_PRICE_EUR_PER_KWH=0.08

# Database Settings (optional)
# SQLITE_JOURNAL_MODE=WAL

# Background Tasks
P1_ENABLE_BACKGROUND_THREADS=true
P1_LIVE_POLL_INTERVAL_SECONDS=2
P1_SAVE_INTERVAL_SECONDS=10
P1_BACKUP_INTERVAL_SECONDS=900
SOLAR_POLL_INTERVAL_SECONDS=2
SOLAR_PERSIST_INTERVAL_SECONDS=10
SOLAR_ROLLUP_INTERVAL_SECONDS=60
SERIES_CACHE_TTL_SECONDS=30
MARSTEK_POLL_INTERVAL_SECONDS=2
MARSTEK_PERSIST_INTERVAL_SECONDS=10
BATTERY_ROLLUP_INTERVAL_SECONDS=60
# Keep false for new installs; true only when importing legacy realtime tables.
PERSIST_REALTIME_SAMPLES=false
P1_MAX_COUNTER_STEP_KWH=0.2
P1_ALLOW_RAW_DB_AUTO_RESTORE=true
